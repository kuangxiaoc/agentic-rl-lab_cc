# Copy to /mnt/workspace/agentic-rl-lab/.env; this file contains no real secrets.
# Future online chapters only. The first local 01-03 experiments make no API calls.
DASHSCOPE_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Hard limits: no paid usage unless both are explicitly changed.
MAX_EXTERNAL_COST_CNY=50
ALLOW_PAID_OVERAGE=0
FREE_TOKEN_LIMIT=1000000

# Default low-cost models (thinking disabled); do not default to large paid models.
DEFAULT_JUDGE_MODEL=deepseek-v4.1-flash
DEFAULT_TEACHER_MODEL=qwen3.8-flash
DEFAULT_SEARCH_PROVIDER=tavily
TAVILY_FREE_SEARCHES_PER_MONTH=1000
SERPAPI_FREE_SEARCHES_PER_MONTH=250

# Persistent workspace. All models, caches, logs and results stay here.
WORKSPACE_ROOT=/mnt/workspace/agentic-rl-lab
HF_HOME=/mnt/workspace/agentic-rl-lab/cache/huggingface
MODELSCOPE_CACHE=/mnt/workspace/agentic-rl-lab/cache/modelscope
RUN_PROFILE=smoke
